# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy anon key

# Only these emails may log in (comma-separated). Leave empty to allow any.
ALLOWED_EMAILS=you@example.com

# Kakao Developers → My Application → App Keys → REST API key (server only)
KAKAO_REST_API_KEY=

# Time zone used for "today" (Vercel servers run in UTC)
APP_TIME_ZONE=Asia/Seoul
